# bot token aus dem developer portal (Bot -> Reset Token)
DISCORD_TOKEN=

# deine user id (discord -> entwicklermodus -> rechtsklick auf dich -> id kopieren)
OWNER_DISCORD_ID=

# server id
DISCORD_GUILD_ID=

# kanal, in dem der bot zuhoert (name oder id). leer = alle kanaele
AGENT_CHANNEL=bot-chat

# --- KI: gratis mit google-konto, key auf aistudio.google.com/apikey ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
OPENAI_MODEL=gemini-3.8-flash

# wenn das modell nicht geht: OPENAI_MODEL=gemini-3.5-flash-lite
# alternativ groq (auch gratis): https://api.groq.com/openai/v1 + llama-3.3-70b-versatile
